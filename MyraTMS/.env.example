# =============================================================================
# Required — Core platform
# =============================================================================

# Neon Postgres serverless connection string.
DATABASE_URL=

# JWT signing secret (httpOnly auth cookies + service tokens used by workers).
# Generate: `openssl rand -hex 32`
JWT_SECRET=

# Mapbox public token. All 3 active apps render maps; gracefully fall back when missing.
NEXT_PUBLIC_MAPBOX_TOKEN=


# =============================================================================
# Required — Redis (Upstash)
# =============================================================================
# MyraTMS needs both pathways to Upstash:
#   - REST API for the cache layer (lib/redis.ts via @upstash/redis)
#   - ioredis TCP URL for BullMQ queues (lib/pipeline/redis-bullmq.ts).
# REST tab of the Upstash console gives KV_REST_API_URL / KV_REST_API_TOKEN;
# Connect → ioredis tab gives UPSTASH_REDIS_URL (rediss://...).

KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_URL=


# =============================================================================
# Required for full functionality
# =============================================================================

# xAI Grok — used by the in-app AI assistant (/api/ai/chat, /api/ai/analyze-risk).
XAI_API_KEY=

# Vercel Blob — document uploads + POD photos.
BLOB_READ_WRITE_TOKEN=


# =============================================================================
# Engine 2 — AI pipeline (Vercel + Railway worker host)
# =============================================================================
# Anthropic SDK for Claude calls (Researcher, Compiler, call-transcript parser).
ANTHROPIC_API_KEY=

# Retell voice agents (Phase 6B). Webhook URL / signature secret are set in the
# Retell dashboard AND verified server-side. Function URL is the inbound
# Retell-to-MyraTMS callback for gatekeeper/agent custom tools.
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=
RETELL_WEBHOOK_URL=
RETELL_FUNCTION_URL=

# Bearer token gating /api/pipeline/import (CSV ingest endpoint).
PIPELINE_IMPORT_TOKEN=

# Bearer token gating the cron routes (/api/cron/*).
# Generate: `openssl rand -hex 32`. Set the SAME value in Vercel
# dashboard → Project Settings → Cron Jobs → Authorization header.
CRON_SECRET=

# Worker host → TMS API base URL (Dispatcher chains the existing /api/loads,
# /assign, /tracking-token, /send-tracking routes via service-token cookie).
# In production, point Railway at the Vercel deployment URL.
TMS_API_URL=

# Kill switches — production deploys start safe.
PIPELINE_ENABLED=false
SCANNER_ENABLED=false
MAX_CONCURRENT_CALLS=0
# AUTO_BOOK_PROFIT_THRESHOLD removed (T-19): never read by any decision path.
# The real margin floor is tenant_config margin_floor_cad/margin_floor_usd, read via lib/tenants/margin-floor.ts.

# Shadow-only shipper-direct classification + tenant-policy evaluation in the
# Qualifier (E2-01 M1 + T-19, wired 2026-08-25). 'true' classifies every load
# and calls evaluatePolicy(), writing load_source_class/authority_evaluations
# for measurement — it never gates qualify/disqualify yet. No ingest path
# captures poster identity (company/MC/DOT) yet, so enforcing on this today
# would reject the entire live pipeline. See lib/workers/qualifier-worker.ts.
SHIPPER_DIRECT_GATE_ENABLED=false
# Required for real (non-error) authority lookups once the gate is enabled;
# register at mobile.fmcsa.dot.gov. Missing key = every lookup resolves to
# 'error', which is fine in shadow mode (just logged, not enforced).
FMCSA_QC_WEBKEY=

# Optional — worker heartbeat interval (ms) for Railway liveness logs.
WORKER_HEARTBEAT_MS=60000


# =============================================================================
# Cross-app URLs (set after deploying each app to its own Vercel project)
# =============================================================================
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DRIVER_APP_URL=
NEXT_PUBLIC_TRACKING_URL=


# =============================================================================
# Optional — Multi-tenant config encryption
# =============================================================================
# AES-256-GCM key (32-byte hex) for encrypted values in tenant_config.
# Required if you're storing secrets per-tenant.
MYRA_TENANT_CONFIG_KEY=


# =============================================================================
# Optional — Email (tracking notifications, POD receipts, factoring)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FACTORING_EMAIL=


# =============================================================================
# Optional — Twilio (driver invites, secondary call channel)
# =============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# =============================================================================
# Optional — External integrations
# =============================================================================
# FMCSA SAFER API — DOT/MC compliance verification + carrier seed enrichment.
FMCSA_API_KEY=

# Load board APIs (official-API ingest pathway, currently stubs).
DAT_API_KEY=
DAT_API_SECRET=
TRUCKSTOP_API_KEY=

# Driver GPS / ELD integrations.
SAMSARA_API_KEY=
MOTIVE_API_KEY=
